          <Overlay Id="QItZTR3dHveOypcAMKBqRm" Name="Screenshot" Bounds="64,1242,718,722" />
          <Pad Id="FUY9bqzsEajNL8w8FtVmdd" Bounds="375,1267,293,222" ShowValueBox="true" isIOBox="true" Value="This set of nodes allows you to create screenshots. In this case, the objects are rendered into an off-screen texture. This texture is then converted into an image, which can be saved to disk. Note that the resolution can be set independently of the viewport size.&#xD;&#xA;&#xD;&#xA;The filename nodes are included for convenience. They generate a filename based on the current date and time, ensuring that existing files are not overwritten by mistake.&#xD;&#xA; ">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
