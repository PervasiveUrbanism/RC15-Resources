              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="HwRJQDiOlcUPWmzJtw7s3Q" Bounds="296,765,162,35" ShowValueBox="true" isIOBox="true" Value="Filter incoming geometry by type or layer. ">
