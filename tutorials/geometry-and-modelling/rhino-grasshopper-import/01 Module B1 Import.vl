          <Pad Id="JCqK03MOIPWN4c9iIQmLV6" Bounds="-8,-78,816,78" ShowValueBox="true" isIOBox="true" Value="Rhino Import &amp; GH Link">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">30</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="HLVCjnMXgUOP8Id3NHjwa0" Bounds="18,34,429,272" ShowValueBox="true" isIOBox="true" Value="This patch shows how to import Rhino geometry and create a live link to Grasshopper. These are two different workflows: static geometry is best imported permanently, while geometry that needs to update dynamically can be linked directly from Grasshopper. In the patch, you can see two separate branches that merge further downstream.&#xD;&#xA;&#xD;&#xA;Please have a look at the help patches, as they demonstrate a wide range of functionality. The plugin reads not only geometry, but also layer information and named views. As a result, it is not necessary to set up views in vvvv, as this can be done directly in Rhino.&#xD;&#xA;&#xD;&#xA;During the import process, be mindful of scaling issues. In this example, the **ScaleToMeters** option is switched off.&#xD;&#xA;">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Up73CCNcpxTOvdmv1H9BTx" Bounds="889,182,162,35" ShowValueBox="true" isIOBox="true" Value="Static rhino import">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
