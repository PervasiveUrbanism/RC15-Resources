          <Pad Id="N6xteuQOX2MPOcc0Pgs7g8" Bounds="711,875,198,135" ShowValueBox="true" isIOBox="true" Value="This is a special case. Stride does not support curves directly, so they are converted into a thin pipe. The thickness cannot be changed. Instead, use transparency to simulate thinner lines.">
