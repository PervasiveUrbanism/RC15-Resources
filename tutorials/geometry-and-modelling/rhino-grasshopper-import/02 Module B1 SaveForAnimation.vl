          <Pad Id="JCqK03MOIPWN4c9iIQmLV6" Bounds="-8,-78,816,78" ShowValueBox="true" isIOBox="true" Value="Save for Animation">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
