          <Overlay Id="Fe6JDgC8aaNMFFtf1rKVTh" Name="Save frames for animation" Bounds="913,2088,571,681" />
          <Pad Id="PyWppiAhpuKL0FbcqMr5mv" Bounds="1506,2103,407,523" ShowValueBox="true" isIOBox="true" Value="1.&#xD;&#xA;This node creates a list from incoming values. Each time **Insert** is triggered, the current value is added to the list. You can define the maximum length of the list and clear it when needed. The node is very flexible and can be used to create lists of almost anything: numbers, text, images, and many other data types.&#xD;&#xA;&#xD;&#xA;2.&#xD;&#xA;Because the images are stored in a list, we need to use a **For Loop** to save each image individually with its own filename.&#xD;&#xA;&#xD;&#xA;3.&#xD;&#xA;The filename is constructed using the index of the list. The **Index** node returns the current loop index. This index is then converted into a string. The **PadLeft** node formats the number as a five-character string, such as *00001*, *00002*, *00003*, and so on. This ensures that the files are correctly ordered and can later be imported into Premiere in the correct sequence.&#xD;&#xA;&#xD;&#xA;4.&#xD;&#xA;Press **Write** to save all images in the list to disk. The images will be written one by one using the generated filenames.&#xD;&#xA;">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Rz8HNeaH69yPBAQNBuyOYV" Bounds="1017,2207,49,28" ShowValueBox="true" isIOBox="true" Value="1.">
