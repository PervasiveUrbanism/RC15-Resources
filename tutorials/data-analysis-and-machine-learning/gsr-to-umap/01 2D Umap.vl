          <Overlay Id="EDzZo1hADumM2bBofqTOGP" Bounds="386,923,854,526" />
          <Pad Id="TBnX9qvoq7jLKn1VmGOsAp" Bounds="1249,456,269,250" ShowValueBox="true" isIOBox="true" Value="Press F2 and you will see that this patch runs at about 55 frames per second. This value depends on your computer and the size of the output window.&#xA;&#xA;Keep in mind that every frame the system reads and parses the text file and rebuilds the graphics. In this example it works fine, but as soon as the patch becomes more complex, you need to think carefully about the computational cost of certain operations — and whether they really need to be executed sixty times per second.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="JWJccF10JhXLFsjKR6OdIH" Bounds="1249,391,223,41" ShowValueBox="true" isIOBox="true" Value="Performance">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="U1Xo6S6h0PELhM9W8TIhF9" Bounds="-10,-91,728,85" ShowValueBox="true" isIOBox="true" Value="Simple UMAP Dispay in 2D">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">40</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="IyxeNAoZFd4Oqn0U5REWm4" Bounds="235,1748,205,78" ShowValueBox="true" isIOBox="true" Value="Now you can save the result as a PDF or export it as a high-resolution image, depending on your output needs.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="NSiAZRdQTrbOQVLOUGcwzC" Bounds="-194,1081,182,212" ShowValueBox="true" isIOBox="true" Value="The list of 2D vectors is passed into another For Each loop. This loop draws very small circles at each position.&#xA;&#xA;The Paint node defines the appearance of those circles. In this case they are blue, and where circles overlap, the color intensity increases.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="I1Cp2nH7sDgM46knY6OrBL" Bounds="-194,492,180,294" ShowValueBox="true" isIOBox="true" Value="The file is saved as a CSV, which can be read using the FileReader node.&#xA;&#xA;The content is then split into lines, the header line is removed, and each remaining entry is processed inside a For Each loop. The result is three lists containing X, Y, and the GSR value.&#xA;&#xA;Note that the X and Y values are combined into a vector.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CQa6hUqQW56O1Ok9WujyVW" Bounds="846,528,271,205" ShowValueBox="true" isIOBox="true" Value="The LFO is widely used. Click on the node and press F1 to see the different modes and options available.&#xA;&#xA;In this example, it sends a signal every half second. That pulse feeds into a counter, which counts from zero to the length of the list. The current index is then used to extract the corresponding GSR value and position.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="HKmBGIvEGeVLRxevwrQz7T" Bounds="867,1007,196,52" ShowValueBox="true" isIOBox="true" Value="The Damper node smooths movements in an animation, helping transitions appear more natural and less abrupt.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">7</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="AeonpxBldeFNy4gZVlsnbi" Bounds="412,1086,191,82" ShowValueBox="true" isIOBox="true" Value="The Complement node returns the complementary color. It’s very useful when you need a strong contrast or want elements to stand out clearly against each other.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">7</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
