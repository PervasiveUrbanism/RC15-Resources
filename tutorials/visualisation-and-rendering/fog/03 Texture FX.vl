            <Pad Id="NxobdvQYhr9MF3gaQtznWy" Bounds="150,518,380,300" ShowValueBox="true" isIOBox="true" Value="Notice that the wires here are white. If you right-click on one of them, you will see that this entire section has been assigned to an operation that runs &quot;On Create&quot;. (that is different form the node &quot;Create&quot; that creates a range)&#xD;&#xA;&#xD;&#xA;This part of the definition is separate from the rest of the patch, which runs continuously at approximately 60 frames per second. The white section is executed only once, when the node is created.&#xD;&#xA;&#xD;&#xA;In this example, it generates a random number that ensures the noise pattern looks different when multiple nodes are created at the same time.&#xD;&#xA;&#xD;&#xA;The &quot;Pad&quot; node separates this initialization logic from the rest of the definition.&#xD;&#xA;">
              <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                <Choice Kind="TypeFlag" Name="String" />
              </p:TypeAnnotation>
              <p:ValueBoxSettings>
                <p:fontsize p:Type="Int32">9</p:fontsize>
