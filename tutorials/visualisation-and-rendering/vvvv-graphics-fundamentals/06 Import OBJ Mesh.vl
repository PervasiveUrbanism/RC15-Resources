          <Overlay Id="GQrey3boisKPiaIx6Y986V" Name="Option 3 - Render as Point Cloud" Bounds="1071,246,821,830" />
          <ControlPoint Id="IiRkye4gGk2LjN8Nq3lsCf" Bounds="1238,230" />
          <ControlPoint Id="HS76H1c6KMsPpQJTvW1hvO" Bounds="161,226" />
          <Pad Id="TNDKpQ8Lr5nPkSXx3aOSs1" Bounds="201,349,175,53" ShowValueBox="true" isIOBox="true" Value="TransformSRT moves, rotates, or scales the mesh.&#xD;&#xA;&#xD;&#xA;Here we use it to translate the object slightly so&#xD;&#xA;multiple rendering options can be displayed next&#xD;&#xA;to each other.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">5</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <ControlPoint Id="SlRYmr8SKLjNAGdU1TLQX4" Bounds="82,940" />
          <Pad Id="NtnhZtIHPCsNpfgcOVYJ9A" Bounds="88,547,295,363" ShowValueBox="true" isIOBox="true" Value="Option 1 is the most obvious way to add a material&#xD;&#xA;when importing a mesh.&#xD;&#xA;&#xD;&#xA;Here we create a simple PBR material and assign it&#xD;&#xA;directly to the mesh. This gives us full control over&#xD;&#xA;the entire material pipeline.&#xD;&#xA;&#xD;&#xA;You can adjust properties such as color (Diffuse),&#xD;&#xA;surface roughness, and other material parameters.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="BEpOf0Q2ot4MaaDRdyTdBF" Bounds="221,476,175,53" ShowValueBox="true" isIOBox="true" Value="ModelEntity connects the geometry with its material, allows transformations and makes it renderable in the scene. &#xD;&#xA;The model can be moved at any other point as well.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">5</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CWZaQ2twQi5OwJlAw3KKqh" Bounds="471,301,315,102" ShowValueBox="true" isIOBox="true" Value="Option 2 renders the mesh as a wireframe.&#xD;&#xA;&#xD;&#xA;Instead of displaying the faces of the mesh, we only render its edges. This shows the underlying topology of the geometry. ">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="HD2F58H2ufLPvpQEw0Qb5l" Bounds="864,308,134,68" ShowValueBox="true" isIOBox="true" Value="GetMeshes extracts the mesh geometry from the imported model.&#xD;&#xA;&#xD;&#xA;Many 3D models can contain multiple meshes. This node allows us to access them individually.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">5</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="C0fB6F0Sf4lQOYP2nn4jpi" Bounds="845,446,159,84" ShowValueBox="true" isIOBox="true" Value="The blend mode controls how the rendered pixels combine with the image already on the screen.&#xD;&#xA;&#xD;&#xA;Additive blending adds the color values together. This makes overlapping lines appear brighter and can create a glowing effect.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">5</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="EGnoeZPSV2gPMUm6jTKbfr" Bounds="863,537,136,36" ShowValueBox="true" isIOBox="true" Value="WireframeCullBack renders only the visible edges of the mesh.&#xD;&#xA;">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">5</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <ControlPoint Id="E0TcJ3uVxcpNGWoszKEb6F" Bounds="846,523" />
          <ControlPoint Id="LjnXGmq5xBrLNR0U0V9C34" Bounds="733,523" />
          <Pad Id="BS3aZGEQULUPqNVwUAUxfH" Bounds="775,732,209,351" ShowValueBox="true" isIOBox="true" Value="← ↑ →&#xD;&#xA;&#xD;&#xA;vvvv provides several nodes for placing geometry into the scene.&#xD;&#xA;They work at different levels of abstraction.&#xD;&#xA;&#xD;&#xA;ModelEntity is the highest-level node. It takes a full 3D model&#xD;&#xA;(often imported from a file) and renders it directly. The node&#xD;&#xA;handles meshes, materials, and other model information internally.&#xD;&#xA;This is the most convenient way to display imported geometry.&#xD;&#xA;&#xD;&#xA;MeshEntity is slightly lower level. Instead of a full model, it&#xD;&#xA;works with a mesh and a material. It still simplifies the rendering&#xD;&#xA;process, but gives you more control over the geometry and material&#xD;&#xA;that are used.&#xD;&#xA;&#xD;&#xA;RenderEntity is the lowest-level option. Here you create the&#xD;&#xA;rendering pipeline manually. You first build a MeshRenderer&#xD;&#xA;(or another renderer), and then attach it to the scene using&#xD;&#xA;RenderEntity. This exposes more of the internal rendering&#xD;&#xA;structure and allows greater flexibility.&#xD;&#xA;&#xD;&#xA;In practice:&#xD;&#xA;ModelEntity → easiest way to display imported models&#xD;&#xA;MeshEntity → simple way to render a mesh with a material&#xD;&#xA;RenderEntity → full control over the rendering pipeline&#xD;&#xA;&#xD;&#xA;All three approaches produce a visible object in the scene.&#xD;&#xA;The difference is mainly how much of the rendering pipeline&#xD;&#xA;is exposed to the user.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
