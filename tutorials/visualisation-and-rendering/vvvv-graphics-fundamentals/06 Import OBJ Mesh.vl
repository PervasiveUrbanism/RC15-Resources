          <Pad Id="N45ehuBYPVfNXcgOd0WX12" Bounds="1571,308,295,363" ShowValueBox="true" isIOBox="true" Value="This area converts the OBJ mesh into a point cloud.&#xD;&#xA;&#xD;&#xA;The mesh is first split to extract the vertex positions.&#xD;&#xA;For each vertex, a new Pos3Norm3Tex2 structure is created containing position, normal, and texture coordinates. These vertices are then assembled into a new DynamicMesh.&#xD;&#xA;&#xD;&#xA;The topology is set to PointList, which means the mesh is rendered as points instead of faces or edges.&#xD;&#xA;&#xD;&#xA;In short: the original mesh is only used as a source of vertices, and a new mesh is rebuilt that renders the vertices as a point cloud.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
