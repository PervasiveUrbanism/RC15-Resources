          <Pad Id="NBQZk0UMNySOfTobfEEL7p" Bounds="-471,6,450,87" ShowValueBox="true" isIOBox="true" Value="Import OBJ">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
