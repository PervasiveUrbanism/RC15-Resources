          <Pad Id="PSc6RxbgpkdPzTWOZxcJ36" Bounds="939,451,224,272" ShowValueBox="true" isIOBox="true" Value="The RootScene connects to the SceneWindow as usual.&#xD;&#xA;&#xD;&#xA;The camera used here is a flat camera, which creates an&#xD;&#xA;orthographic view. This means objects are displayed without&#xD;&#xA;perspective distortion.&#xD;&#xA;&#xD;&#xA;Use TransformSRT to position the camera correctly.&#xD;&#xA;&#xD;&#xA;In the render window, press F4 to open the scene overview.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="GeZm4suTrLxOsxrx6hhMSX" Bounds="351,926,71,82" ShowValueBox="true" isIOBox="true" Value="3.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">40</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="ByxDjtHdUw2NWz28KpXNLy" Bounds="351,1008,247,240" ShowValueBox="true" isIOBox="true" Value="This node creates a texture.&#xD;&#xA;&#xD;&#xA;A texture is an image that is not displayed directly on the screen.&#xD;&#xA;Instead, it can be used as an input for other operations.&#xD;&#xA;&#xD;&#xA;You can define the size (resolution) of the texture.&#xD;&#xA;You can think of it as an image that is rendered offscreen&#xD;&#xA;and then used later in the pipeline.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Overlay Id="CCZEn3aR9eWQEaZHl0wsEC" Bounds="634,361,550,378" />
          <Overlay Id="B18DMr8SJ07NK6V9sCEmRB" Bounds="27,868,608,403" />
          <Overlay Id="SzO8SXwiBXmQcjUcOQcwai" Bounds="29,1322,627,574" />
          <Pad Id="J6zFhbklK8eLC96VMNXoLN" Bounds="379,1723,237,125" ShowValueBox="true" isIOBox="true" Value="With the image available, we can now apply filters.&#xD;&#xA;&#xD;&#xA;&quot;Glitch&quot; is one of many available image effects.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
