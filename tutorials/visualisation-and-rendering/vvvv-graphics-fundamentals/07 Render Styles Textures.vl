          <Pad Id="JyV1BlhPcZTOnCxPEToRdc" Bounds="325,2118,311,230" ShowValueBox="true" isIOBox="true" Value="To display a texture, it needs to be applied to geometry.&#xD;&#xA;&#xD;&#xA;In this case, the texture is mapped onto a quad (a simple rectangular surface). The render window then displays this geometry with the texture applied.&#xD;&#xA;&#xD;&#xA;This is a relatively low-level workflow, but it gives full control over how the image is rendered.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Overlay Id="SYNsUoJGz2JLHVKpZzRcAs" Bounds="898,772,1237,624" />
