          <Pad Id="IvHuht5sQ2kNILb2gDsKpW" Bounds="-619,105,441,317" ShowValueBox="true" isIOBox="true" Value="This patch demonstrates how to apply texture-based effects to an image.&#xD;&#xA;&#xD;&#xA;The input image can be an imported picture or, as in this example,&#xD;&#xA;a rendered image from the scene.&#xD;&#xA;&#xD;&#xA;This is similar to image effects you may know from Photoshop,&#xD;&#xA;but here the effects are interactive and can be combined into&#xD;&#xA;a processing chain.&#xD;&#xA;&#xD;&#xA;There are two main sources for these filters:&#xD;&#xA;one is included in the Stride package,&#xD;&#xA;and the other comes from an external library called vl.addons.&#xD;&#xA;Both need to be installed.&#xD;&#xA;&#xD;&#xA;This patch also introduces a few new techniques.&#xD;&#xA;It is best to follow it step by step.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
