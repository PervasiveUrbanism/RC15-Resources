          <Pad Id="E6ly73MBkVRO7B0ZRUf04G" Bounds="1537,744,290,253" ShowValueBox="true" isIOBox="true" Value="This node setup allows you to save the image to your hard drive.&#xD;&#xA;&#xD;&#xA;By default, the Scene Texture and the Scene Window are fully independent, which means they do not share a camera. If you want the exported image to match the viewport exactly, both need to use the same camera.&#xD;&#xA;&#xD;&#xA;This setup makes it possible to define the view interactively in the Scene Window and then export the exact same view at a much higher resolution using the Scene Texture.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Ogq6C9i5sq3LkYXRQFNt4a" Bounds="1901,1016,282,99" ShowValueBox="true" isIOBox="true" Value="In this case, the same file is overwritten each time.&#xD;&#xA;If you do not want this behaviour, you need to generate a filename that is always unique.&#xD;&#xA;See the example below:">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
